# NextAuth encrypted, HttpOnly session cookie configuration.
NEXTAUTH_URL=http://localhost:3000
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-a-generated-random-secret

# Private server-to-server API URL; never prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Development Authentication Adapter (enabled for local dev without Cognito)
DEV_AUTH_ENABLED=true
NEXT_PUBLIC_DEV_AUTH_ENABLED=true

# Amazon Cognito User Pool OIDC app client (for staging / production).
# When enabled, set NEXT_PUBLIC_OIDC_ENABLED=true and NEXT_PUBLIC_DEV_AUTH_ENABLED=false
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
COGNITO_CLIENT_ID=replace-with-app-client-id
COGNITO_CLIENT_SECRET=replace-with-app-client-secret
NEXT_PUBLIC_OIDC_ENABLED=false
