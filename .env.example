# ==============================================================================
# FORTEUX ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Configuration (Primary Auth & Database Infrastructure)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FastApi Backend URL
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Development Authentication Adapter (fallback for local offline dev)
DEV_AUTH_ENABLED=true
NEXT_PUBLIC_DEV_AUTH_ENABLED=true

# NextAuth session configuration (legacy / backward compatibility)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-generated-random-secret
