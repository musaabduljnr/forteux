# Application Environment: 'development', 'test', or 'production'
# In production, TLS database connections, HTTPS OIDC/S3 URLs, and production guards are enforced.
APP_ENV=development
LOG_LEVEL=DEBUG
API_PREFIX=/api/v1

# PostgreSQL Database URL
# Local dev (Docker): postgresql+psycopg://forteux:forteux_dev_password@localhost:5432/forteux
# Production: postgresql+psycopg://user:password@rds-endpoint:5432/forteux?sslmode=require
DATABASE_URL=postgresql+psycopg://forteux:forteux_dev_password@localhost:5432/forteux

# Development Authentication Adapter (Only active when APP_ENV != production)
# In production, DEV_AUTH_ENABLED=true triggers immediate startup failure.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=forteux-local-dev-jwt-signing-secret-key-32bytes

# Amazon Cognito access-token verification (Used in Staging/Production).
# OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
# OIDC_CLIENT_ID=replace-with-app-client-id
# OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=

# Storage: MinIO (Local Dev) or Amazon S3 (Staging / Production)
# For local MinIO:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=forteux-private-screenshots
S3_ENDPOINT_URL=http://localhost:9000
S3_UPLOAD_TTL_SECONDS=300
S3_DOWNLOAD_TTL_SECONDS=300

# File Upload limits (default: 10 MiB)
MAX_UPLOAD_BYTES=10485760

# Allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
